/* Chronoforge — premium editor theme. Sober, dense, high-contrast. */

.cf-root {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(30, 32, 36);
    color: rgb(210, 214, 220);
}

/* ---- Top toolbar ---- */
.cf-toolbar {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgb(38, 41, 46);
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 21, 24);
}

.cf-toolbar__title {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(232, 236, 242);
    margin-right: 12px;
}

.cf-quickadd {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.cf-chip {
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: rgb(52, 56, 62);
    border-width: 0;
    color: rgb(214, 219, 226);
    font-size: 11px;
}

.cf-chip:hover {
    background-color: rgb(66, 71, 79);
}

.cf-chip--active {
    background-color: rgb(76, 154, 255);
    color: rgb(18, 20, 24);
}

/* ---- Diff rows ---- */
.cf-diff {
    flex-direction: row;
    align-items: center;
    padding: 3px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(24, 26, 29);
}

.cf-diff__glyph {
    width: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 6px;
}

.cf-diff__text {
    flex-grow: 1;
    font-size: 11px;
    white-space: normal;
    color: rgb(200, 205, 213);
}

.cf-diff--added .cf-diff__glyph { color: rgb(92, 184, 92); }
.cf-diff--removed .cf-diff__glyph { color: rgb(224, 84, 74); }
.cf-diff--changed .cf-diff__glyph { color: rgb(224, 168, 52); }

/* ---- Body: three columns ---- */
.cf-body {
    flex-direction: row;
    flex-grow: 1;
}

.cf-column {
    flex-direction: column;
    background-color: rgb(30, 32, 36);
    border-right-width: 1px;
    border-right-color: rgb(20, 21, 24);
}

.cf-column--list { width: 38%; min-width: 240px; }
.cf-column--details { flex-grow: 1; }
.cf-column--side { width: 26%; min-width: 220px; border-right-width: 0; }

.cf-section-header {
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(150, 158, 168);
    padding: 6px 8px 4px 8px;
    letter-spacing: 0.5px;
}

/* ---- Search ---- */
.cf-searchbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 21, 24);
}

.cf-searchbar > .unity-base-field { flex-grow: 1; }

/* ---- List rows ---- */
.cf-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 6px;
    padding-right: 6px;
}

.cf-row__supply {
    width: 34px;
    -unity-text-align: middle-right;
    color: rgb(150, 158, 168);
    font-size: 11px;
}

.cf-row__time {
    width: 42px;
    -unity-text-align: middle-right;
    margin-right: 8px;
    color: rgb(180, 186, 196);
    font-size: 11px;
}

.cf-row__badge {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
}

.cf-row__title {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgb(220, 224, 230);
}

.cf-row__title--empty {
    color: rgb(120, 126, 136);
    -unity-font-style: italic;
}

.cf-row__state {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-left: 6px;
}

.cf-state--ok { background-color: rgba(0, 0, 0, 0); }
.cf-state--warning { background-color: rgb(224, 168, 52); }
.cf-state--error { background-color: rgb(224, 84, 74); }

/* ---- Details panel ---- */
.cf-details {
    padding: 8px;
}

.cf-field-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.cf-details .unity-base-field__label {
    min-width: 96px;
    color: rgb(160, 167, 177);
}

.cf-subheader {
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(150, 158, 168);
    margin-top: 10px;
    margin-bottom: 4px;
}

/* ---- Validation ---- */
.cf-issue {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(24, 26, 29);
}

.cf-issue__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-top: 4px;
    margin-right: 8px;
}

.cf-issue__msg {
    flex-grow: 1;
    white-space: normal;
    font-size: 11px;
    color: rgb(200, 205, 213);
}

.cf-issue--info .cf-issue__dot { background-color: rgb(90, 150, 224); }
.cf-issue--warning .cf-issue__dot { background-color: rgb(224, 168, 52); }
.cf-issue--error .cf-issue__dot { background-color: rgb(224, 84, 74); }

/* ---- Timeline ---- */
.cf-timeline {
    flex-direction: column;
    padding: 6px 8px;
}

.cf-timeline__bar {
    height: 14px;
    border-radius: 3px;
    margin-bottom: 3px;
    background-color: rgb(76, 154, 255);
}

.cf-timeline__bar--shortfall {
    background-color: rgb(224, 84, 74);
}

.cf-timeline__marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(140, 155, 171, 0.55);
}

.cf-timeline__marker--pass { background-color: rgba(92, 184, 92, 0.8); }
.cf-timeline__marker--fail { background-color: rgba(224, 168, 52, 0.9); }

/* ---- Benchmarks ---- */
.cf-benchmark {
    flex-direction: column;
    margin: 4px 8px 6px 8px;
    padding: 6px 8px;
    border-radius: 4px;
    background-color: rgb(36, 39, 44);
    border-left-width: 2px;
    border-left-color: rgb(60, 64, 70);
}

.cf-benchmark__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: rgb(90, 96, 104);
}

.cf-benchmark__dot--pass { background-color: rgb(92, 184, 92); }
.cf-benchmark__dot--fail { background-color: rgb(224, 168, 52); }

.cf-benchmark__detail {
    margin-top: 4px;
    font-size: 10px;
    color: rgb(140, 148, 158);
    -unity-font-style: italic;
}

.cf-benchmark .unity-base-field__label {
    min-width: 64px;
    color: rgb(150, 158, 168);
}

/* ---- Empty states ---- */
.cf-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.cf-empty__text {
    color: rgb(120, 126, 136);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---- Footer / status ---- */
.cf-status {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 8px;
    background-color: rgb(38, 41, 46);
    border-top-width: 1px;
    border-top-color: rgb(20, 21, 24);
    color: rgb(150, 158, 168);
    font-size: 11px;
}
